rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isBlocked() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlocked == true;
    }

    // ===============================================================
    // Users Collection (Task 2.16 & Spec Section 13.1)
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Cho phép đăng ký role customer hoặc barber, mặc định chưa bị khóa
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.role in ['customer', 'barber']
        && request.resource.data.isBlocked == false;
      
      // Admin được quyền sửa toàn bộ (khóa user, đổi role)
      // Chủ tài khoản được sửa thông tin cá nhân nhưng không được tự đổi role hay gỡ blocked
      allow update: if isAdmin() || (
        isOwner(userId) && !isBlocked() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'isBlocked', 'uid', 'email', 'createdAt'])
      );
      
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Barber Profiles Collection (Task 2.16 & Spec Section 13.1)
    // ===============================================================
    match /barberProfiles/{barberId} {
      // Khách hàng chỉ xem được thợ đã được duyệt (approved). Thợ & Admin xem được cả pending
      allow read: if isAdmin() || isOwner(barberId) || resource.data.approvalStatus == 'approved';
      
      // Thợ tạo hồ sơ ban đầu luôn ở trạng thái pending
      allow create: if isOwner(barberId) 
        && request.resource.data.approvalStatus == 'pending';
      
      // Admin được duyệt/từ chối hồ sơ
      // Thợ được cập nhật thông tin tiệm nhưng không được tự duyệt hoặc sửa điểm rating
      allow update: if isAdmin() || (
        isOwner(barberId) && !isBlocked() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['approvalStatus', 'ratingAvg', 'ratingCount', 'uid', 'createdAt'])
      );
      
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Appointments Collection (Week 4 MVP - Task 4.15 & Spec Section 13.1)
    // ===============================================================
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.barberId == request.auth.uid || 
        isAdmin()
      );
      
      // Khách hàng không bị khóa tạo lịch hẹn mới với status ban đầu là 'pending'
      allow create: if isAuthenticated() 
        && !isBlocked()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending';
      
      // Khách hàng chỉ được phép hủy lịch hẹn của mình khi đang ở trạng thái pending hoặc confirmed
      allow update: if isAuthenticated() && !isBlocked()
        && request.auth.uid == resource.data.customerId
        && request.resource.data.status == 'cancelled'
        && resource.data.status in ['pending', 'confirmed'];

      // Thợ cắt tóc chỉ thao tác lịch liên quan đến tiệm mình (xác nhận, từ chối, hoàn tất)
      allow update: if isAuthenticated() && !isBlocked()
        && request.auth.uid == resource.data.barberId
        && request.resource.data.status in ['confirmed', 'rejected', 'completed'];

      // Admin toàn quyền can thiệp
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Booked Slots Collection (Week 4 - Chống trùng lịch Task 4.15)
    // ===============================================================
    match /bookedSlots/{slotId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && !isBlocked();
      allow delete: if isAuthenticated() && !isBlocked();
      allow update: if false; // Không cho phép cập nhật, chỉ tạo mới hoặc xóa trong Transaction
    }

    // ===============================================================
    // Hairstyle Catalog Collection (Danh mục kiểu tóc chuẩn)
    // ===============================================================
    match /hairstyleCatalog/{styleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
